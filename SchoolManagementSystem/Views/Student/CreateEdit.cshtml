@* @model SchoolManagementSystem.Models.ViewModels.StudentViewModel

@{
    ViewData["Title"] = Model.Id == null ? "Add Student" : "Edit Student";
}

<h2 class="text-primary mb-4">@ViewData["Title"]</h2>


<form asp-action="CreateEdit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <!-- First & Last Name -->
    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label">First Name</label>
            <input asp-for="FirstName" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Last Name</label>
            <input asp-for="LastName" class="form-control" />
        </div>
    </div>

    <!-- Email -->
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
    </div>

    <!-- Password -->
    <div class="mb-3">
        <label class="form-label">Password</label>
        <input asp-for="Password" type="password" class="form-control" />
        <small class="text-muted">Required only when adding a new student.</small>
    </div>

    <!-- Country & City -->
    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label">Country</label>
            <select asp-for="CountryId" asp-items="Model.Countries" class="form-select">
                <option value="">-- Select Country --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">City</label>
            <select asp-for="CityId" asp-items="Model.Cities" class="form-select">
                <option value="">-- Select City --</option>
            </select>
        </div>
    </div>

    <!-- Phone & Address -->
    <div class="mb-3">
        <label class="form-label">Phone</label>
        <input asp-for="PhoneNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Address</label>
        <input asp-for="Address" class="form-control" />
    </div>

    <!-- Profile Image -->
    <div class="mb-3">
        <label class="form-label">Profile Image</label>
        <input asp-for="ProfileImageFile" type="file" class="form-control mb-2" />
        <video id="video" width="320" height="240" autoplay class="mb-2"></video>
        <button type="button" id="snap" class="btn btn-secondary btn-sm mb-2">Capture Photo</button>
        <canvas id="canvas" width="320" height="240" style="display:none;"></canvas>
        <input type="hidden" asp-for="ProfileImageBase64" />

        @if (!string.IsNullOrEmpty(Model.ExistingProfileImage))
        {
            <div class="mt-2">
                <strong>Current Image:</strong><br />
                <img src="~/images/@Model.ExistingProfileImage" style="max-width:150px; border-radius:5px;" />
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">@ViewData["Title"]</button>
</form>

@section Scripts {
    <script>
        var video = document.getElementById('video');
        var canvas = document.getElementById('canvas');
        var context = canvas.getContext('2d');
        var snap = document.getElementById('snap');
        var hiddenInput = document.querySelector('input[name="ProfileImageBase64"]');

        navigator.mediaDevices.getUserMedia({ video: true })
            .then(stream => video.srcObject = stream)
            .catch(err => console.error(err));

        snap.addEventListener('click', function () {
            context.drawImage(video, 0, 0, 320, 240);
            hiddenInput.value = canvas.toDataURL('image/png');
            alert("Photo captured successfully!");
        });
    </script>
} *@
