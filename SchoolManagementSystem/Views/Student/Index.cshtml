@model IEnumerable<SchoolManagementSystem.Models.ApplicationUser>

@{
    ViewData["Title"] = "Manage Students";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold text-primary mb-0">Students</h3>

    <div class="d-flex gap-2">
        <a asp-action="SaveStudent" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>Add Student
        </a>

        <a asp-action="ExportPdf" class="btn btn-danger">
            <i class="bi bi-file-earmark-pdf-fill"></i> Export PDF
        </a>

        <a asp-action="ExportExcel" class="btn btn-success">
            <i class="bi bi-file-earmark-spreadsheet-fill"></i> Export Excel
        </a>
    </div>
</div>



<table id="studentTable" class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Country</th>
            <th>City</th>
            <th>Address</th>
            
            <th style="width:200px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.FirstName @student.LastName</td>
                <td>@student.Email</td>
                <td>@student.PhoneNumber</td>
                <td>@student.Country?.Name</td>
                <td>@student.City?.Name</td>
                <td>@student.Address</td>
                
                <td>
                    <a asp-action="SaveStudent" asp-route-id="@student.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil-square"></i></a>
                    <form asp-action="Delete"
                          asp-controller="Student"
                          method="post"
                          style="display:inline;"
                          onsubmit="return confirm('Are you sure you want to delete this student?');">

                        <input type="hidden" name="id" value="@student.Id" />

                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>

                    
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#studentTable').DataTable();
        });
    </script>
}
