@model IEnumerable<SchoolManagementSystem.Models.ApplicationUser>

@{
    ViewData["Title"] = "Manage Students";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold text-primary mb-0">Students</h3>

    <div class="d-flex gap-2">
        <a asp-action="SaveStudent" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>Add Student
        </a>

        <a asp-action="ExportPdf" class="btn btn-danger">
            <i class="bi bi-file-earmark-pdf-fill"></i> Export PDF
        </a>

        <a asp-action="ExportExcel" class="btn btn-success">
            <i class="bi bi-file-earmark-spreadsheet-fill"></i> Export Excel
        </a>

        <button class="btn btn-primary mb-2" data-bs-toggle="modal" data-bs-target="#importStudentModal">
            <i class="bi bi-upload"></i> Import Students
        </button>
        
    </div>
</div>

<!-- Import Students Modal -->
<div class="modal fade" id="importStudentModal" tabindex="-1" aria-labelledby="importStudentLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <!-- Form for Excel Upload -->
            <form asp-action="ImportStudentExcel" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="importStudentLabel">Import Students Excel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="file" name="file" accept=".xlsx, .xls" class="form-control" required />
                    <small class="text-muted">Only Excel (.xlsx or .xls) files are allowed.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-upload"></i> Import
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table id="studentTable" class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Country</th>
            <th>City</th>
            <th>Address</th>
            
            <th style="width:200px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.FirstName @student.LastName</td>
                <td>@student.Email</td>
                <td>@student.PhoneNumber</td>
                <td>@student.Country?.Name</td>
                <td>@student.City?.Name</td>
                <td>@student.Address</td>
                
                <td>
                    <a asp-action="SaveStudent" asp-route-id="@student.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil-square"></i></a>
                    <form asp-action="Delete"
                          asp-controller="Student"
                          method="post"
                          style="display:inline;"
                          onsubmit="return confirm('Are you sure you want to delete this student?');">

                        <input type="hidden" name="id" value="@student.Id" />

                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>

                    
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#studentTable').DataTable();
        });
    </script>
}
