@model SchoolManagementSystem.Models.ViewModels.LoginViewModel

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg border-0" style="max-width: 420px; width: 100%;">
        <div class="card-header text-center bg-light border-0 py-4">
            <h3 class="fw-bold text-primary mb-0">Welcome Back</h3>
            <p class="text-muted mb-0">Please login to your account</p>
        </div>

        <div class="card-body p-4">
            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input asp-for="Email"
                           class="form-control form-control-lg"
                           placeholder="Enter your email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <input asp-for="Password"
                           type="password"
                           class="form-control form-control-lg"
                           placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        Login
                    </button>
                </div>
            </form>

            <!-- ================= REGISTER PROMPT ================= -->
            <div class="text-center mt-4 border-top pt-3">
                <p class="mb-2 fw-semibold text-muted">Don't have an account?</p>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">
                    Create New Account
                </a>
            </div>
        </div>

        <div class="card-footer text-center bg-white border-0 pb-4">
            <small class="text-muted">
                © 2026 School Management System
            </small>
        </div>
    </div>
</div>
