@{
    ViewData["Title"] = "Delete Profile";
}
<div class="container mt-5">
    <div class="card shadow-sm border-0 p-4" style="max-width:500px; margin:auto;">
        <h3 class="text-danger mb-4">Delete Your Account</h3>
        <p class="mb-3">
            Are you sure you want to delete your profile? This action <strong>cannot be undone</strong>.
        </p>

        <form asp-action="DeleteProfileConfirmed" method="post">
            <div class="d-flex justify-content-between">
                <a asp-controller="Account" asp-action="Profile" class="btn btn-secondary">
                    Cancel
                </a>
                <button type="submit" class="btn btn-danger">Delete Account</button>
            </div>
        </form>
    </div>
</div>
