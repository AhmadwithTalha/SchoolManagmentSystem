@model SchoolManagementSystem.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<h2>Register</h2>

<form asp-action="Register" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label>First Name</label>
        <input asp-for="FirstName" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Last Name</label>
        <input asp-for="LastName" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Country</label>
        <input asp-for="Country" class="form-control" />
    </div>
    <div class="mb-3">
        <label>City</label>
        <input asp-for="City" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Address</label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Phone Number</label>
        <input asp-for="PhoneNumber" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Email</label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Password</label>
        <input asp-for="Password" type="password" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Confirm Password</label>
        <input asp-for="ConfirmPassword" type="password" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Profile Image (from Camera or Upload)</label>
        <input asp-for="ProfileImageFile" type="file" accept="image/*" capture="user" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Register</button>
</form>
