@model SchoolManagementSystem.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg border-0" style="max-width: 720px; width: 100%;">
        <div class="card-header text-center bg-light border-0 py-4">
            <h3 class="fw-bold text-primary mb-0">Create Account</h3>
            <p class="text-muted mb-0">Register to access the system</p>
        </div>

        <div class="card-body p-4">
            <form asp-action="Register" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">First Name</label>
                        <input asp-for="FirstName" class="form-control form-control-lg" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Last Name</label>
                        <input asp-for="LastName" class="form-control form-control-lg" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Country</label>
                        <input asp-for="Country" class="form-control form-control-lg" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">City</label>
                        <input asp-for="City" class="form-control form-control-lg" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Address</label>
                    <input asp-for="Address" class="form-control form-control-lg" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control form-control-lg" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" class="form-control form-control-lg" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Password</label>
                        <input asp-for="Password" type="password" class="form-control form-control-lg" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Upload Profile Picture (Optional)</label>
                    <input asp-for="ProfileImageFile" type="file" class="form-control form-control-lg" />
                </div>

                <!-- Camera Capture Section -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">Capture Photo</label>
                    <div class="border rounded p-3 bg-light text-center">
                        <video id="video" class="rounded mb-2" width="320" height="240" autoplay></video>
                        <div>
                            <button type="button" id="snap" class="btn btn-outline-primary btn-sm">
                                Capture Photo
                            </button>
                        </div>
                        <canvas id="canvas" width="320" height="240" class="d-none"></canvas>
                        <input type="hidden" id="ProfileImageBase64" name="ProfileImageBase64" />
                    </div>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        Register
                    </button>
                </div>
            </form>
        </div>

        <div class="card-footer text-center bg-white border-0 pb-4">
            <small class="text-muted">
                Already have an account?
                <a asp-controller="Account" asp-action="Login" class="text-primary fw-semibold">
                    Login
                </a>
            </small>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const video = document.getElementById('video');
        const canvas = document.getElementById('canvas');
        const context = canvas.getContext('2d');
        const snap = document.getElementById('snap');
        const hiddenInput = document.getElementById('ProfileImageBase64');

        navigator.mediaDevices.getUserMedia({ video: true })
            .then(stream => video.srcObject = stream)
            .catch(err => console.error(err));

        snap.addEventListener('click', function () {
            context.drawImage(video, 0, 0, 320, 240);
            hiddenInput.value = canvas.toDataURL('image/png');
            alert("Photo captured successfully!");
        });
    </script>
}
