@{
    ViewData["Title"] = "About Us";
}

<!-- ================= PAGE HEADER ================= -->
<section class="bg-white py-5 border-bottom">
    <div class="container text-center">
        <h1 class="fw-bold text-primary">About Our School Management System</h1>
        <p class="lead text-muted mt-3">
            Empowering schools with smart, secure, and efficient digital solutions.
        </p>
    </div>
</section>

<!-- ================= ABOUT CONTENT ================= -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 mb-4 mb-md-0">
                <h3 class="fw-bold mb-3">Who We Are</h3>
                <p class="text-muted">
                    Our School Management System is a modern web-based platform
                    designed to simplify administrative tasks, improve communication,
                    and enhance academic management for educational institutions.
                </p>

                <p class="text-muted">
                    We focus on providing a secure, scalable, and user-friendly
                    solution that helps schools manage students, teachers,
                    and daily operations efficiently.
                </p>
            </div>

            @* <div class="col-md-6 text-center">
                <img src="https://via.placeholder.com/500x300"
                     class="img-fluid rounded shadow-sm"
                     alt="About School System">
            </div> *@
        </div>
    </div>
</section>

<!-- ================= MISSION & VISION ================= -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <i class="bi bi-bullseye fs-1 text-primary"></i>
                        <h4 class="fw-bold mt-3">Our Mission</h4>
                        <p class="text-muted">
                            To deliver a reliable and efficient school management
                            platform that reduces manual work, improves transparency,
                            and supports academic excellence.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <i class="bi bi-eye-fill fs-1 text-primary"></i>
                        <h4 class="fw-bold mt-3">Our Vision</h4>
                        <p class="text-muted">
                            To become a trusted digital solution for schools,
                            enabling smarter decision-making and better
                            educational outcomes worldwide.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= WHY CHOOSE US ================= -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Why Choose Us?</h2>
            <p class="text-muted">
                Built with modern technology and real educational needs in mind
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-4 text-center">
                <i class="bi bi-shield-lock-fill fs-1 text-primary"></i>
                <h5 class="fw-semibold mt-3">Secure System</h5>
                <p class="text-muted">
                    Strong authentication and data protection ensure
                    privacy and security.
                </p>
            </div>

            <div class="col-md-4 text-center">
                <i class="bi bi-speedometer2 fs-1 text-primary"></i>
                <h5 class="fw-semibold mt-3">Efficient Management</h5>
                <p class="text-muted">
                    Automates daily tasks and reduces paperwork
                    for administrators.
                </p>
            </div>

            <div class="col-md-4 text-center">
                <i class="bi bi-people-fill fs-1 text-primary"></i>
                <h5 class="fw-semibold mt-3">User Friendly</h5>
                <p class="text-muted">
                    Simple interface designed for principals,
                    teachers, and staff.
                </p>
            </div>
        </div>
    </div>
</section>
