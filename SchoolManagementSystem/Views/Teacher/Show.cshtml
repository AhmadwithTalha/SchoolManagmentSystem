@model IEnumerable<SchoolManagementSystem.Models.ApplicationUser>

@{
    ViewData["Title"] = "Teacher List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="fw-bold text-primary mb-3">Teachers</h2>

<div class="mb-3">
    <a class="btn btn-primary" asp-action="TeacherRegister">
        + Create Teacher
    </a>
</div>

<table id="teacherTable" class="table table-bordered table-striped">
    <thead>
        <tr>
            @* <th>Profile</th> *@
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Country</th>
            <th>City</th>
            <th>Address</th>
            <th style="width:200px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var teacher in Model)
        {
            <tr>
                @* <td>
                    <img src="~/images/@teacher.ProfileImage"
                         width="45"
                         height="45"
                         class="rounded-circle"
                         onerror="this.src='/images/default.png'" />
                </td> *@

                <td>@teacher.FirstName @teacher.LastName</td>
                <td>@teacher.Email</td>
                <td>@teacher.PhoneNumberPublic</td>

                <td>@teacher.Country?.Name</td>
                <td>@teacher.City?.Name</td>

                <td>@teacher.Address</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@teacher.Id"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <form asp-action="Delete"
                          asp-controller="Teacher"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this teacher?');">

                        <input type="hidden" name="id" value="@teacher.Id" />

                        <button type="submit" class="btn btn-sm btn-danger">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {

    <!-- DataTables CSS -->
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#teacherTable').DataTable();
        });
    </script>
}
