

@model SchoolManagementSystem.Models.ViewModels.TeacherRegisterViewModel;

@{
    ViewData["Title"] = "Create Teacher";
    Layout = "~/Views/Shared/_Layout.cshtml"; // ✅ Correct layout
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-12 col-md-10">

            <div class="card shadow-sm">
                <div class="card-body">

                    <div class="mb-4 text-center">
                        <h4 class="fw-bold">Create Teacher</h4>
                        <p class="text-muted small">Enter teacher personal details</p>
                    </div>

                    <form asp-action="TeacherRegister" method="post" enctype="multipart/form-data" class="row g-3">

                        <div asp-validation-summary="All" class="text-danger small"></div>

                        <div class="col-md-6">
                            <label class="form-label">First Name</label>
                            <input asp-for="FirstName" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Last Name</label>
                            <input asp-for="LastName" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Country</label>
                            <select asp-for="CountryId" asp-items="Model.Countries" class="form-select" id="CountryId">
                                <option value="">-- Select Country --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">City</label>
                            <select asp-for="CityId" asp-items="Model.Cities" class="form-select" id="CityId">
                                <option value="">-- Select City --</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Address</label>
                            <input asp-for="Address" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Upload Profile Picture</label>
                            <input asp-for="ProfileImageFile" type="file" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Capture Photo</label>
                            <div class="border rounded p-3 bg-light text-center">
                                <video id="video" width="320" height="240" autoplay class="rounded mb-2"></video>
                                <br />
                                <button type="button" id="snap" class="btn btn-outline-primary btn-sm">
                                    Capture Photo
                                </button>
                                <canvas id="canvas" width="320" height="240" class="d-none"></canvas>
                                <input type="hidden" id="ProfileImageBase64" name="ProfileImageBase64" />
                            </div>
                        </div>

                        <div class="col-12 text-end">
                            <button class="btn btn-primary px-4">
                                Save Teacher
                            </button>
                            <a asp-action="Index" class="btn btn-secondary ms-2">
                                Back
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const video = document.getElementById('video');
        const canvas = document.getElementById('canvas');
        const context = canvas.getContext('2d');
        const snap = document.getElementById('snap');
        const hiddenInput = document.getElementById('ProfileImageBase64');

        navigator.mediaDevices.getUserMedia({ video: true })
            .then(stream => video.srcObject = stream);

        snap.addEventListener('click', function () {
            context.drawImage(video, 0, 0, 320, 240);
            hiddenInput.value = canvas.toDataURL('image/png');
            alert("Photo captured successfully!");
        });

        $('#CountryId').change(function () {
            var countryId = $(this).val();
            $('#CityId').empty().append('<option value="">-- Select City --</option>');

            if (countryId) {
                $.getJSON('/Account/GetCitiesByCountry', { countryId }, function (data) {
                    $.each(data, function (i, city) {
                        $('#CityId').append(`<option value="${city.id}">${city.name}</option>`);
                    });
                });
            }
        });
    </script>
}
