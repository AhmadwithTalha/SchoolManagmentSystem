

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold text-primary mb-0">Countries</h3>

    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Country
        </a>

        <a asp-action="ExportPdf" class="btn btn-danger">
            <i class="bi bi-file-earmark-pdf-fill"></i> Export PDF
        </a>

        <a asp-action="ExportExcel" class="btn btn-success">
            <i class="bi bi-file-earmark-spreadsheet-fill"></i> Export Excel
        </a>

       
        <button class="btn btn-primary mb-2" data-bs-toggle="modal" data-bs-target="#importCountryModal">
            <i class="bi bi-upload"></i> Import Countries
        </button>
       
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@Html.Raw(TempData["Success"])</div>
}

@if (TempData["Errors"] != null)
{
    <div class="alert alert-danger">@Html.Raw(TempData["Errors"])</div>
}

<table id="countryTable" class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th style="width:200px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var country in Model)
        {
            <tr>
                <td>@country.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@country.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil-square"></i></a>
                    <a asp-action="Delete" asp-route-id="@country.Id" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#countryTable').DataTable({
                "paging": true,           // Enable pagination
                "searching": true,        // Enable search box
                "ordering": true,         // Enable column sorting
                "info": true,             // Show "Showing x of y entries"
                "lengthChange": true,     // Allow changing number of rows per page
                "columnDefs": [
                    { "orderable": false, "targets": 1 } // Actions column should not be sortable
                ]
            });
        });
    </script>
}
<!-- Import Modal -->
<div class="modal fade" id="importCountryModal" tabindex="-1" aria-labelledby="importCountryLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="importCountryLabel">Import Countries Excel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="file" name="excelFile" accept=".xlsx" class="form-control" required />
                    <small class="text-muted">Only Excel (.xlsx) files are allowed.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-upload"></i> Import
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>