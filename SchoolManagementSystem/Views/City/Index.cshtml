
@model IEnumerable<SchoolManagementSystem.Models.City>

@{
    ViewData["Title"] = "City Management";
}

<div class="container mt-4">


    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-primary mb-0">Cities</h3>

        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Add City
            </a>

            <a asp-action="ExportPdf" class="btn btn-danger">
                <i class="bi bi-file-earmark-pdf-fill"></i> Export PDF
            </a>

            <a asp-action="ExportExcel" class="btn btn-success">
                <i class="bi bi-file-earmark-spreadsheet-fill"></i> Export Excel
            </a>
        </div>
    </div>
    <!-- City Table -->
    <table id="cityTable" class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>City Name</th>
                <th>Country Name</th>
                <th style="width:200px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var city in Model)
            {
                <tr>
                    <td>@city.Name</td>
                    <td>@city.Country.Name</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@city.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil-square"></i></a>
                        <a asp-action="Delete" asp-route-id="@city.Id" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#cityTable').DataTable({
                "paging": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "lengthChange": true,
                "columnDefs": [
                    { "orderable": false, "targets": 2 } // Actions column
                ]
            });
        });
    </script>
}
