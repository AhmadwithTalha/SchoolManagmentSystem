
@model IEnumerable<SchoolManagementSystem.Models.City>

@{
    ViewData["Title"] = "City Management";
}

<div class="container mt-4">


    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-primary mb-0">Cities</h3>

        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Add City
            </a>

            <a asp-action="ExportPdf" class="btn btn-danger">
                <i class="bi bi-file-earmark-pdf-fill"></i> Export PDF
            </a>

            <a asp-action="ExportExcel" class="btn btn-success">
                <i class="bi bi-file-earmark-spreadsheet-fill"></i> Export Excel
            </a>

            <form asp-action="ImportExcel" enctype="multipart/form-data" method="post">
               
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                    <i class="bi bi-upload"></i> Import Excel
                </button>

            </form>
        </div>
    </div>
    <!-- City Table -->
    <table id="cityTable" class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>City Name</th>
                <th>Country Name</th>
                <th style="width:200px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var city in Model)
            {
                <tr>
                    <td>@city.Name</td>
                    <td>@city.Country.Name</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@city.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil-square"></i></a>
                        <a asp-action="Delete" asp-route-id="@city.Id" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@Html.Raw(TempData["Success"])</div>
}

@if (TempData["Errors"] != null)
{
    <div class="alert alert-danger">@Html.Raw(TempData["Errors"])</div>
}
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#cityTable').DataTable({
                "paging": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "lengthChange": true,
                "columnDefs": [
                    { "orderable": false, "targets": 2 } // Actions column
                ]
            });
        });
    </script>
}
<!-- Import Excel Modal -->
<div class="modal fade" id="importExcelModal" tabindex="-1" aria-labelledby="importExcelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="importExcelModalLabel">Import Excel File</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label for="excelFile" class="form-label">Choose Excel File (.xlsx)</label>
                        <input type="file" name="excelFile" class="form-control" accept=".xlsx" required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Import</button>
                </div>
            </form>
        </div>
    </div>
</div>
